generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  DOCTOR
  PATIENT
}

enum AccountApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  MEDICAL_CERTIFICATE
  PRESCRIPTION
  MEDICAL_REPORT
}

enum UnitType {
  UPA
  UNIMED
}

enum RequestStatus {
  RECEIVED
  UNDER_REVIEW
  ADDITIONAL_INFORMATION_REQUIRED
  AI_DRAFT_IN_PREPARATION
  AI_DRAFT_READY
  ADMIN_REVIEW
  PREVIEW_IN_PREPARATION
  PREVIEW_READY
  PREVIEW_SENT
  CORRECTION_REQUESTED
  PREVIEW_APPROVED
  WAITING_PAYMENT_REQUEST
  PAYMENT_REQUESTED
  PIX_QR_CODE_GENERATED
  PIX_QR_CODE_SENT
  WAITING_PAYMENT
  PAYMENT_PROOF_SENT
  PAYMENT_UNDER_REVIEW
  PAYMENT_REJECTED
  PAYMENT_APPROVED
  WAITING_MEDICAL_REVIEW
  WAITING_SIGNATURE
  FINAL_DOCUMENT_IN_PREPARATION
  FINAL_DOCUMENT_SIGNED
  FINAL_DOCUMENT_AUTHENTICATED
  FINAL_DOCUMENT_AVAILABLE
  FINAL_DOCUMENT_SENT
  COMPLETED
  CANCELLED
}

enum AttachmentType {
  EXAM
  PRESCRIPTION
  PREVIOUS_REPORT
  PREVIOUS_CERTIFICATE
  MEDICAL_RECORD
  IMAGE
  PAYMENT_PROOF
  OTHER
}

enum DocumentFileType {
  PREVIEW
  FINAL
  SIGNED_FINAL
  PIX_QR_CODE
  PAYMENT_PROOF
  ATTACHMENT
}

enum PaymentStatus {
  NOT_STARTED
  PIX_REQUESTED
  PIX_GENERATED
  PIX_SENT
  WAITING_PAYMENT
  PROOF_SENT
  UNDER_REVIEW
  REJECTED
  APPROVED
  CANCELLED
}

enum PaymentProofStatus {
  SENT
  UNDER_REVIEW
  REJECTED
  APPROVED
}

enum GeneratedDocumentStatus {
  AI_DRAFT
  ADMIN_REVIEW
  PREVIEW_READY
  PREVIEW_SENT
  CORRECTION_REQUESTED
  PREVIEW_APPROVED
  WAITING_PAYMENT
  PAYMENT_APPROVED
  MEDICAL_REVIEW
  WAITING_SIGNATURE
  SIGNED
  AUTHENTICATED
  SENT_TO_PATIENT
  CANCELLED
  REPLACED
}

enum SignatureProvider {
  ICP_BRASIL
  MEMED
  OTHER
}

enum VerificationStatus {
  INACTIVE
  VALID
  CANCELLED
  REPLACED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role           UserRole              @default(PATIENT)
  active         Boolean               @default(true)
  approvalStatus AccountApprovalStatus @default(APPROVED)
  approvedAt     DateTime?
  rejectedAt     DateTime?

  patientProfiles Patient[]
  doctorProfile  DoctorProfile?

  assignedRequests ServiceRequest[] @relation("AssignedDoctor")
  requestedRequests ServiceRequest[] @relation("RequestedBy")
  uploadedFiles    DocumentFile[]    @relation("UploadedBy")
  statusEvents     StatusEvent[]     @relation("ChangedBy")

  generatedDocuments GeneratedDocument[] @relation("GeneratedBy")
  approvedDocuments  GeneratedDocument[] @relation("DocumentApprovedBy")
  digitalSignatures  DigitalSignature[]   @relation("DocumentSignedBy")

  reviewedPayments      Payment[]      @relation("PaymentReviewedBy")
  reviewedPaymentProofs PaymentProof[] @relation("PaymentProofReviewedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([active])
  @@index([approvalStatus])
}

model DoctorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  crm       String
  crmState  String
  specialty String?
  phone     String?

  signatureProvider      SignatureProvider?
  certificateSerial      String?
  certificateIssuer      String?
  certificateValidUntil  DateTime?
  memedDoctorId          String?
  memedIntegrationKey    String?
  authorizedToSign       Boolean @default(false)
  active                 Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([crm, crmState])
  @@index([active])
  @@index([authorizedToSign])
}

model Patient {
  id           String   @id @default(cuid())
  userId       String?
  fullName     String
  cpf          String   @unique
  birthDate    DateTime
  motherName   String
  phone        String
  email        String
  address      String
  city         String?
  state        String?
  postalCode   String?
  active       Boolean  @default(true)

  nickname     String?
  relationship String?
  isPrimary    Boolean  @default(false)

  user     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([fullName])
  @@index([phone])
  @@index([email])
  @@index([isPrimary])
}

model ServiceRequest {
  id       String @id @default(cuid())
  protocol String @unique

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  assignedDoctorId String?
  assignedDoctor   User? @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id], onDelete: SetNull)

  requestedByUserId String?
  requestedBy       User? @relation("RequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  documentType DocumentType
  status       RequestStatus @default(RECEIVED)

  certificatePeriod String?
  certificateDays   Int?

  reportPurpose     String?
  reportDescription String?

  cid             String?
  symptoms        String
  preferredTime   String
  additionalNotes String?

  unitType UnitType
  unitName String

  priceCents Int

  patientConfirmedPreview Boolean   @default(false)
  previewConfirmedAt      DateTime?
  correctionReason        String?

  paymentRequestedAt DateTime?
  paymentApprovedAt  DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?

  medications        MedicationRequest[]
  attachments        Attachment[]
  documents          DocumentFile[]
  generatedDocuments GeneratedDocument[]
  payment            Payment?
  statusHistory      StatusEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([assignedDoctorId])
  @@index([requestedByUserId])
  @@index([status])
  @@index([documentType])
  @@index([unitType])
  @@index([createdAt])
}

model MedicationRequest {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  position           Int
  name               String
  dosage             String
  pharmaceuticalForm String
  boxQuantity        Int
  instructions       String
  notes              String?

  approvedByDoctor Boolean @default(false)
  doctorNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, position])
  @@index([requestId])
  @@index([name])
}

model Attachment {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  type         AttachmentType
  originalName String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  description  String?

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([type])
}

model DocumentFile {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  type         DocumentFileType
  originalName String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  version      Int     @default(1)
  active       Boolean @default(true)

  downloadedAt DateTime?
  createdAt    DateTime @default(now())

  @@index([requestId])
  @@index([uploadedById])
  @@index([type])
  @@index([active])
}

model GeneratedDocument {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  documentType DocumentType
  template     UnitType
  status       GeneratedDocumentStatus @default(AI_DRAFT)

  documentNumber String @unique
  version        Int    @default(1)

  aiDraftContent String?
  finalContent   String?

  generatedById String
  generatedBy   User @relation("GeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)

  approvedById String?
  approvedBy   User? @relation("DocumentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  approvedAt DateTime?

  previewStorageKey  String?
  previewMimeType    String?
  previewGeneratedAt DateTime?
  previewSentAt      DateTime?

  previewWatermark       String  @default("PRÉVIA — SEM VALIDADE")
  previewDownloadAllowed Boolean @default(false)
  previewPrintAllowed    Boolean @default(false)
  previewHasValidQrCode  Boolean @default(false)

  finalStorageKey   String?
  finalMimeType     String?
  finalSizeBytes    Int?
  finalGeneratedAt  DateTime?
  finalSentAt       DateTime?

  fileHash String?

  verificationCode   String? @unique
  verificationUrl    String?
  verificationQrCode String?

  verificationStatus  VerificationStatus @default(INACTIVE)
  authenticationActive Boolean            @default(false)
  authenticatedAt      DateTime?

  cancelledAt       DateTime?
  cancellationReason String?

  replacedByDocumentId String?
  replacedAt           DateTime?

  signature DigitalSignature?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([documentType])
  @@index([template])
  @@index([status])
  @@index([verificationStatus])
  @@index([authenticationActive])
  @@index([createdAt])
}

model DigitalSignature {
  id                  String            @id @default(cuid())
  generatedDocumentId String            @unique
  generatedDocument   GeneratedDocument @relation(fields: [generatedDocumentId], references: [id], onDelete: Cascade)

  signedById String
  signedBy   User @relation("DocumentSignedBy", fields: [signedById], references: [id], onDelete: Restrict)

  provider SignatureProvider

  doctorName String
  crm        String
  crmState   String

  certificateSerial     String?
  certificateIssuer     String?
  certificateSubject    String?
  certificateValidFrom  DateTime?
  certificateValidUntil DateTime?

  externalSignatureId String?
  externalDocumentId  String?

  signedFileHash String
  signatureHash  String?
  signedAt       DateTime

  createdAt DateTime @default(now())

  @@index([signedById])
  @@index([provider])
  @@index([signedAt])
}

model Payment {
  id        String         @id @default(cuid())
  requestId String         @unique
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  status      PaymentStatus @default(NOT_STARTED)
  amountCents Int

  pixKey           String?
  receiverName     String?
  receiverDocument String?

  pixTransactionId  String?
  qrCodeUrl         String?
  qrCodeStorageKey  String?
  qrCodePayload     String?
  qrCodeGeneratedAt DateTime?
  qrCodeSentAt      DateTime?
  expiresAt         DateTime?

  reviewedById String?
  reviewedBy   User? @relation("PaymentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  rejectionReason String?
  reviewedAt      DateTime?
  approvedAt      DateTime?

  proofs PaymentProof[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reviewedById])
}

model PaymentProof {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  status PaymentProofStatus @default(SENT)

  originalName String
  storageKey   String
  mimeType     String
  sizeBytes    Int

  payerName       String?
  paidAmountCents Int?
  paidAt          DateTime?
  transactionId   String?

  patientNote String?
  adminNote   String?

  reviewedById String?
  reviewedBy   User? @relation("PaymentProofReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  rejectionReason String?
  reviewedAt      DateTime?
  approvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([reviewedById])
  @@index([createdAt])
}

model StatusEvent {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  status RequestStatus
  note   String?

  changedById String?
  changedBy   User? @relation("ChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  visibleToPatient Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([status])
  @@index([changedById])
  @@index([createdAt])
}
